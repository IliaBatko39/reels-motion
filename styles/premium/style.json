{
  "title": "Премиум-минимал",
  "description": "Тёмное матовое стекло с тонкой светлой обводкой и бегущим бликом, тёплый акцент, контурные цифры 01–03, раскрытие текста из-под маски, мягкий засвет на швах, тонкая полоска прогресса. Субтитры белые, слово встаёт при произнесении.",
  "extends": "base",
  "module": "premium.js",
  "components": { "*": "premium" },
  "extras": ["progress"],
  "tokens": {
    "color": { "ink": "#FFFFFF", "paper": "rgba(23,22,28,.72)", "accent": "#FFC24D", "accent2": "#FFC24D", "plate": "rgba(28,28,34,.70)",
               "plate_text": "#FFFFFF", "tag": "rgba(14,14,18,.80)", "tag_text": "#FFFFFF", "muted": "rgba(255,255,255,.78)", "line": "#FFC24D",
               "shadow": "rgba(0,0,0,.42)" },
    "fonts": { "head": "'Inter', sans-serif", "head_weight": 900, "body": "'Inter', sans-serif", "body_weight": 700 },
    "plate": { "shape": "glass", "radius": 34, "outline": 0, "border": 1.5, "border_color": "rgba(255,255,255,.45)",
               "shadow": "0 18px 26px rgba(0,0,0,.42)", "rotate": 0, "pointer": "line" },
    "chip": { "radius": 60, "fill": "rgba(28,28,34,.70)", "text": "#FFFFFF", "dot": "#FFC24D" },
    "text": { "accent_mark": "underline" }
  },
  "motion": { "enter": "wipe", "enter_dur": 0.5, "ease_in": "spring:0.5", "from_scale": 0.86, "from_rotate": 0, "from_y": 46, "text_reveal": "mask",
              "idle": { "float": 2, "rotate": 0, "shine_period": 1.9 } },
  "captions": { "variant": "clean", "size": 70, "stroke": 7, "stroke_color": "rgba(0,0,0,.55)", "accent_color": "#FFC24D", "case": "as-is",
                "max_chars": 16, "lead": 0.05, "tail": 0.25, "split_on_cuts": true, "hang": false },
  "camera": {
    "punch_scale": 1.07, "punch_ease": "outCubic", "punch_frames": 5, "punch_lead_f": 1, "punch_release": 0,
    "shake": { "kind": "sine", "amp": 7, "dur": 0.1, "decay": 14, "scale": 1.02 },
    "frost": true, "interp": "lanczos"
  },
  "transitions": {
    "whip": { "at": ["block:0", "cta", "answer"], "table": { "-2": [-60, 36], "-1": [-260, 150], "0": [260, 150], "1": [60, 36] }, "zoom": 1.03,
              "post": false, "sfx": "whoosh", "gain_db": -15 },
    "flash": { "at": ["block:1", "block:2", "block:3"], "peak": 0.78, "rise_f": 2, "tau": 0.06, "dur": 0.25, "table": null, "post": true,
               "radial": { "size": [0.9, 0.6], "at": [0.5, 0.4], "stops": [[0, [255, 250, 240, 1]], [0.45, [255, 240, 215, 0.92]], [1, [255, 226, 180, 0.7]]] },
               "sfx": "whoosh", "gain_db": -15 }
  },
  "audio": {
    "voice": "highpass=f=80,acompressor=threshold=0.125:ratio=2.5:attack=15:release=180:makeup=1",
    "music": { "preset": "pad", "bpm": 96, "level_lu": -9, "start": "live" },
    "sidechain": { "threshold": 0.05, "ratio": 4, "attack": 30, "release": 400 },
    "sfx": { "pop": -14, "click": -20, "whoosh": -15, "swoosh_down": -14, "riser": -20, "hit": -12, "ping": -17, "swish": -20 },
    "freeze_accent": null,
    "master": { "lufs": -14, "tp": -1.5, "limit": 0.85 }
  },
  "blur": { "sub": 4, "shutter": 0.5 }
}
